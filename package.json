{
  "name": "game-library-check",
  "version": "2.0.4",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tools/register-typescript.cjs --test tests/*.test.js",
    "itch": "node ./tools/itch.js",
    "gog": "node ./tools/gog.js",
    "epic": "node ./tools/epic.js",
    "cube": "node ./tools/cube.js",
    "test:merged": "node ./tools/run-merged-check.js",
    "merged": "node ./tools/build-merged-esbuild.js && node ./tools/merged.js",
    "build": "npm run merged",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:merged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HCLonely/Game-library-check.git"
  },
  "author": "HCLonely",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HCLonely/Game-library-check/issues"
  },
  "homepage": "https://github.com/HCLonely/Game-library-check#readme",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.16.11",
    "babel-eslint": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.10.0",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "defaults"
  ]
}
